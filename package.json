{
  "name": "scraptrace",
  "version": "0.1.0",
  "private": true,
  "description": "ScrapTrace monorepo",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @scraptrace/web",
    "build": "npm run build --workspace @scraptrace/contracts && npm run build --workspace @scraptrace/web",
    "typecheck": "npm run typecheck --workspace @scraptrace/contracts && npm run typecheck --workspace @scraptrace/web",
    "lint": "npm run lint --workspace @scraptrace/web",
    "format": "prettier --write package.json tsconfig.base.json eslint.config.mjs README.md 'apps/web/**/*.{ts,tsx,mjs,json,css,md}' docs/decisions/ADR-008-frontend-architecture.md",
    "format:check": "prettier --check package.json tsconfig.base.json eslint.config.mjs README.md 'apps/web/**/*.{ts,tsx,mjs,json,css,md}' docs/decisions/ADR-008-frontend-architecture.md",
    "test": "npm run test --workspace @scraptrace/contracts && npm run test --workspace @scraptrace/web",
    "test:e2e": "npm run test:e2e --workspace @scraptrace/web",
    "contracts:generate": "npm run schema:generate --workspace @scraptrace/contracts",
    "contracts:check": "npm run check --workspace @scraptrace/contracts",
    "api:dev": "PYTHONPATH=. .venv/bin/python -m uvicorn apps.api.app.main:app --reload --host 127.0.0.1 --port 8000",
    "api:test": "PYTHONPATH=. .venv/bin/python -m pytest -c apps/api/pyproject.toml",
    "api:lint": ".venv/bin/ruff check apps/api services/vision/manifest.py services/vision/predictor.py services/vision/predict.py",
    "api:format:check": ".venv/bin/ruff format --check apps/api services/vision/manifest.py services/vision/predictor.py services/vision/predict.py",
    "api:typecheck": ".venv/bin/mypy --config-file apps/api/pyproject.toml",
    "vision:download": "PYTHONPATH=. .venv/bin/python services/vision/extract_crops.py",
    "vision:train": "PYTHONPATH=. .venv/bin/python services/vision/train.py",
    "vision:train:foundation": "PYTHONPATH=. .venv/bin/python services/vision/train_foundation.py",
    "vision:fetch:roboflow": "PYTHONPATH=. .venv/bin/python services/vision/fetch_roboflow_data.py",
    "vision:weights": "PYTHONPATH=. .venv/bin/python services/vision/download_weights.py",
    "vision:setup": "PYTHONPATH=. .venv/bin/python services/vision/setup_all.py",
    "vision:predict": "PYTHONPATH=. .venv/bin/python services/vision/predict.py",
    "vision:audit:size": "PYTHONPATH=. .venv/bin/python services/vision/check_large_files.py",
    "audit:production": "npm audit --omit=dev"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript": "6.0.3"
  }
}
