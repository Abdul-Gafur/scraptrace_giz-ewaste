{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "qr_payload": {
          "type": "object",
          "properties": {
            "contract_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "record_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "lookup_token": {
              "type": "string",
              "minLength": 24,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "contract_version",
            "record_id",
            "lookup_token"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "qr_payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "qr_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "qr_text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "manual_transfer_code": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
        }
      },
      "required": [
        "manual_transfer_code"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/handoff_lookup_request.schema.json",
  "title": "handoff_lookup_request"
}
