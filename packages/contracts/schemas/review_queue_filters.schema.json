{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "status": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "flag_code": {
      "type": "string",
      "enum": [
        "WEIGHT_DISCREPANCY",
        "CATEGORY_DISAGREEMENT",
        "DUPLICATE_EVIDENCE_DIGEST",
        "INCOMPLETE_EVIDENCE",
        "MISSING_MATERIAL_WEIGHTS",
        "PROCESSED_WEIGHT_ABOVE_RECEIVED"
      ]
    },
    "opened_from": {
      "$ref": "#/$defs/__schema1"
    },
    "opened_to": {
      "$ref": "#/$defs/__schema1"
    },
    "facility_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sort": {
      "default": "opened_at",
      "type": "string",
      "enum": [
        "opened_at",
        "-opened_at"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "open",
        "awaiting_information",
        "approved",
        "rejected"
      ]
    },
    "__schema1": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/review_queue_filters.schema.json",
  "title": "review_queue_filters"
}
