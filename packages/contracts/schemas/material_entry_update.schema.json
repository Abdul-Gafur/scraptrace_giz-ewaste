{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "material": {
      "$ref": "#/$defs/__schema0"
    },
    "weight": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "g"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/material_entry_update.schema.json",
  "title": "material_entry_update"
}
