{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "categories": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "coarse_area": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "receiving_location_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "states": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "limit": {
          "default": 25,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "pagination"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "refrigerators",
        "laptops_and_desktop_computers",
        "televisions",
        "microwaves",
        "air_conditioners",
        "compressors",
        "mixed_scrap"
      ]
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awaiting_handoff",
        "received",
        "processing_recorded",
        "completed",
        "under_review",
        "approved_and_completed",
        "rejected"
      ]
    }
  },
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/reporting_filters.schema.json",
  "title": "reporting_filters"
}
