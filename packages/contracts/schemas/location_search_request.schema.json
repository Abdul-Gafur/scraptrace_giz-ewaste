{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "search_origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "coordinates"
            },
            "coordinates": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "accuracy_metres": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "device",
                    "manual",
                    "facility",
                    "imported"
                  ]
                }
              },
              "required": [
                "latitude",
                "longitude",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manual_area"
            },
            "area": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "administrative_area": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "country_code": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2,
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "required": [
                "label",
                "country_code"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "area"
          ],
          "additionalProperties": false
        }
      ]
    },
    "radius_km": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 500
    },
    "categories": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "facility_types": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "offline": {
      "type": "boolean"
    }
  },
  "required": [
    "search_origin",
    "radius_km",
    "categories",
    "offline"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "refrigerators",
        "laptops_and_desktop_computers",
        "televisions",
        "microwaves",
        "air_conditioners",
        "compressors",
        "mixed_scrap"
      ]
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "scrapyard",
        "collection_centre",
        "recycler"
      ]
    }
  },
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/location_search_request.schema.json",
  "title": "location_search_request"
}
