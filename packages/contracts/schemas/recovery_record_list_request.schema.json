{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "state": {
      "maxItems": 9,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "category": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "captured_from": {
      "$ref": "#/$defs/__schema2"
    },
    "captured_to": {
      "$ref": "#/$defs/__schema2"
    },
    "sort": {
      "default": "-created_at",
      "type": "string",
      "enum": [
        "created_at",
        "-created_at",
        "updated_at",
        "-updated_at",
        "captured_at",
        "-captured_at"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "awaiting_handoff",
        "received",
        "processing_recorded",
        "completed",
        "under_review",
        "approved_and_completed",
        "rejected"
      ]
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "refrigerators",
        "laptops_and_desktop_computers",
        "televisions",
        "microwaves",
        "air_conditioners",
        "compressors",
        "mixed_scrap"
      ]
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$id": "https://schemas.scraptrace.local/contracts/1.0.0/recovery_record_list_request.schema.json",
  "title": "recovery_record_list_request"
}
