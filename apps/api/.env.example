SCRAPTRACE_ENVIRONMENT=development
SCRAPTRACE_HOST=127.0.0.1
SCRAPTRACE_PORT=8000
SCRAPTRACE_ALLOWED_ORIGINS=http://localhost:3000
SCRAPTRACE_CHECKPOINT_PATH=services/vision/checkpoints/best_model.pth
SCRAPTRACE_MODEL_MANIFEST_PATH=services/vision/checkpoints/model_manifest.json
SCRAPTRACE_RUNTIME_DEVICE=cpu
SCRAPTRACE_MAXIMUM_UPLOAD_BYTES=5242880
SCRAPTRACE_MAXIMUM_IMAGE_WIDTH=8192
SCRAPTRACE_MAXIMUM_IMAGE_HEIGHT=8192
SCRAPTRACE_MAXIMUM_IMAGE_PIXELS=25000000
SCRAPTRACE_CONFIDENCE_THRESHOLD=0.40
SCRAPTRACE_AMBIGUITY_MARGIN=0.05
SCRAPTRACE_INFERENCE_TIMEOUT_SECONDS=15
SCRAPTRACE_MAXIMUM_CONCURRENT_INFERENCES=2
SCRAPTRACE_LOG_LEVEL=INFO
