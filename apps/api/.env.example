SCRAPTRACE_ENVIRONMENT=development
SCRAPTRACE_HOST=127.0.0.1
SCRAPTRACE_PORT=8000
SCRAPTRACE_ALLOWED_ORIGINS=http://127.0.0.1:3000
SCRAPTRACE_CHECKPOINT_PATH=services/vision/checkpoints/best_model.pth
SCRAPTRACE_MODEL_MANIFEST_PATH=services/vision/checkpoints/model_manifest.json
SCRAPTRACE_RUNTIME_DEVICE=cpu
SCRAPTRACE_MAXIMUM_UPLOAD_BYTES=5242880
SCRAPTRACE_MAXIMUM_IMAGE_WIDTH=8192
SCRAPTRACE_MAXIMUM_IMAGE_HEIGHT=8192
SCRAPTRACE_MAXIMUM_IMAGE_PIXELS=25000000
SCRAPTRACE_CONFIDENCE_THRESHOLD=0.40
SCRAPTRACE_AMBIGUITY_MARGIN=0.05
SCRAPTRACE_INFERENCE_TIMEOUT_SECONDS=15
SCRAPTRACE_MAXIMUM_CONCURRENT_INFERENCES=2
SCRAPTRACE_LOG_LEVEL=INFO

# Persistence (required). PostgreSQL via asyncpg; SQLite is accepted only when
# SCRAPTRACE_ENVIRONMENT=test. Never commit a real credential.
SCRAPTRACE_DATABASE_URL=postgresql+asyncpg://scraptrace:<local-password>@127.0.0.1:55432/scraptrace
SCRAPTRACE_DATABASE_POOL_SIZE=5
SCRAPTRACE_DATABASE_MAX_OVERFLOW=5
SCRAPTRACE_DATABASE_POOL_TIMEOUT_SECONDS=10
SCRAPTRACE_DATABASE_STATEMENT_TIMEOUT_SECONDS=15

# Seeding (explicit command only; refused in production). At least 12 characters.
SCRAPTRACE_SEED_DEMO_PASSWORD=<generate-a-local-demo-password>
# Password hashing (Argon2id) cost parameters.
SCRAPTRACE_PASSWORD_HASH_TIME_COST=3
SCRAPTRACE_PASSWORD_HASH_MEMORY_COST_KIB=65536
SCRAPTRACE_PASSWORD_HASH_PARALLELISM=2

# Idempotency outcome retention and accepted client clock skew.
SCRAPTRACE_IDEMPOTENCY_RETENTION_DAYS=30
SCRAPTRACE_CLOCK_SKEW_SECONDS=300

# Authentication (required). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCRAPTRACE_AUTH_TOKEN_SECRET=<generate-a-random-value-of-at-least-32-characters>
SCRAPTRACE_AUTH_TOKEN_TTL_SECONDS=1800
# Secure cookies default to true in production and false elsewhere (http://localhost).
SCRAPTRACE_AUTH_COOKIE_SECURE=
SCRAPTRACE_SIGN_IN_RATE_LIMIT_ATTEMPTS=5
SCRAPTRACE_SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=900
# Development/test only: list demonstration accounts (usernames and roles) for the UI.
SCRAPTRACE_ENABLE_DEMO_ACCOUNT_DISCOVERY=false
# Vision appraisal requires authentication; production refuses false.
SCRAPTRACE_VISION_REQUIRES_AUTHENTICATION=true

# QR lookup tokens (required). Must differ from the auth secret. Rotating it invalidates every
# issued QR code, so rotate only with a planned re-issue.
SCRAPTRACE_QR_TOKEN_SECRET=<generate-a-different-random-value-of-at-least-32-characters>
SCRAPTRACE_QR_TOKEN_TTL_DAYS=30

# Evidence object storage (local filesystem for the hackathon; keep outside web roots).
SCRAPTRACE_EVIDENCE_STORAGE_ROOT=apps/api/.data/evidence

# QR/transfer-code lookups per recycler.
SCRAPTRACE_LOOKUP_RATE_LIMIT_ATTEMPTS=30
SCRAPTRACE_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
